<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Student List View -->
    <record id="academy_student_view_list" model="ir.ui.view">
        <field name="name">academy.student.list</field>
        <field name="model">academy.student</field>
        <field name="arch" type="xml">
	    <list string="Students">
		<field name="student_id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="date_of_birth"/>
                <field name="gender"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Student Kanban View -->
    <record id="academy_student_view_kanban" model="ir.ui.view">
        <field name="name">academy.student.kanban</field>
        <field name="model">academy.student</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="student_id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="course_id"/>
                <field name="state"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <article class="o_kanban_record">
                            <field name="name" class="fw-bold fs-5"/>
                            <div class="text-muted">
                                <field name="student_id"/>
                            </div>
                            <div t-if="record.course_id.raw_value" class="mt-2">
                                <strong>Course:</strong>
                                <field name="course_id"/>
                            </div>
                            <div t-if="record.email.raw_value" class="text-muted mt-1">
                                <field name="email"/>
                            </div>
                        </article>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Student Form View -->
    <record id="academy_student_view_form" model="ir.ui.view">
        <field name="name">academy.student.form</field>
        <field name="model">academy.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <header>
                    <button name="action_enroll" string="Enroll" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_graduate" string="Graduate" type="object"
                            class="btn-primary" invisible="state != 'enrolled'"/>
                    <button name="action_drop" string="Drop" type="object"
                            invisible="state not in ('draft', 'enrolled')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('dropped', 'graduated')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,enrolled,graduated"/>
                </header>
                <sheet>

		    <div class="oe_title">
			<field name="student_id" readonly="1"/>
			
			<label for="name"/>
                        <h1>
                            <field name="name" placeholder="Student Name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="email"/>
			    <field name="phone"/>
			    <field name="user_id" groups="academy_management.group_academy_manager"/>
			    <field name="course_id"/>
			    <field name="subject_ids" widget="many2many_tags"/>
                        </group>

                        <group>
			    <field name="date_of_birth"/>
			    <field name="age" readonly="1"/>
                            <field name="gender"/>
                            <field name="active"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Open Students Action -->
    <record id="academy_student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">academy.student</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first student!
            </p>
        </field>
    </record>

    <!-- Main Academy Menu -->
    <menuitem
        id="academy_management_menu_root"
        name="Academy Management"
        sequence="10"
        groups="academy_management.group_academy_manager,academy_management.group_academy_teacher,academy_management.group_academy_student"
    />

    <!-- Students Menu -->
    <menuitem
        id="academy_student_menu"
        name="Students"
        parent="academy_management_menu_root"
        action="academy_student_action"
        sequence="10"
    />
</odoo>
