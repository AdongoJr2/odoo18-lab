<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="academy_dashboard_view_form" model="ir.ui.view">
        <field name="name">academy.dashboard.form</field>
        <field name="model">academy.dashboard</field>
        <field name="arch" type="xml">
            <form string="Academy Dashboard" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="row g-3 mt-3">
                        <div class="col-12 col-md-4">
                            <button name="action_open_students" type="object"
                                    class="btn btn-outline-primary w-100 text-start p-3">
                                <span class="d-block fs-2 fw-bold"><field name="total_students"/></span>
                                <span>Total Students</span>
                            </button>
                        </div>
                        <div class="col-12 col-md-4">
                            <button name="action_open_students" type="object"
                                    class="btn btn-outline-success w-100 text-start p-3">
                                <span class="d-block fs-2 fw-bold"><field name="enrolled_students"/></span>
                                <span>Enrolled Students</span>
                            </button>
                        </div>
                        <div class="col-12 col-md-4">
                            <button name="action_open_courses" type="object"
                                    class="btn btn-outline-info w-100 text-start p-3">
                                <span class="d-block fs-2 fw-bold"><field name="total_courses"/></span>
                                <span>Total Courses</span>
                            </button>
                        </div>
                        <div class="col-12 col-md-4">
                            <button name="action_open_courses" type="object"
                                    class="btn btn-outline-warning w-100 text-start p-3">
                                <span class="d-block fs-2 fw-bold"><field name="full_courses"/></span>
                                <span>Full Courses</span>
                            </button>
                        </div>
                        <div class="col-12 col-md-4">
                            <button name="action_open_attendance" type="object"
                                    class="btn btn-outline-secondary w-100 text-start p-3">
                                <span class="d-block fs-2 fw-bold"><field name="attendance_records"/></span>
                                <span>Attendance Records</span>
                            </button>
                        </div>
                        <div class="col-12 col-md-4">
                            <button name="action_open_attendance_analysis" type="object"
                                    class="btn btn-outline-dark w-100 text-start p-3">
                                <span class="d-block fs-2 fw-bold"><field name="attendance_rate"/>%</span>
                                <span>Present Rate</span>
                            </button>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="academy_dashboard_record" model="academy.dashboard">
        <field name="name">Academy Overview</field>
    </record>

    <record id="academy_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">academy.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="academy_dashboard_record"/>
    </record>

    <menuitem id="academy_dashboard_menu" name="Dashboard"
              parent="academy_management_menu_root"
              action="academy_dashboard_action" sequence="1"
              groups="academy_management.group_academy_manager,academy_management.group_academy_teacher"/>
</odoo>
