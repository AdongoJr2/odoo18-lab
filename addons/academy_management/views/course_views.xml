<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Course List View -->
    <record id="academy_course_view_list" model="ir.ui.view">
        <field name="name">academy.course.list</field>
        <field name="model">academy.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="capacity"/>
                <field name="student_count"/>
                <field name="is_full"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Course Form View -->
    <record id="academy_course_view_form" model="ir.ui.view">
        <field name="name">academy.course.form</field>
        <field name="model">academy.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Course Name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="description"/>
                        <field name="capacity"/>
                        <field name="price"/>
                        <field name="product_id" readonly="1"/>
                        <field name="customer_id"/>
                        <field name="invoice_id" readonly="1"/>
                        <field name="invoice_state" readonly="1"/>
                        <field name="invoice_payment_state" readonly="1"/>
                        <field name="student_count" readonly="1"/>
                        <field name="is_full" readonly="1"/>
                        <field name="active"/>

                        <button name="action_open_sales" type="object"
                                string="View Sales Orders" class="btn btn-outline-primary"/>
                        <button name="action_create_invoice" type="object"
                                string="Create Invoice" class="btn btn-outline-secondary"/>
                        <button name="action_open_invoice" type="object"
                                string="Open Invoice" class="btn btn-outline-secondary"
                                invisible="not invoice_id"/>
                        <button name="action_post_invoice" type="object"
                                string="Post Invoice" class="btn btn-outline-warning"
                                invisible="not invoice_id or invoice_state != 'draft'"/>
                        <button name="action_register_invoice_payment" type="object"
                                string="Register Payment" class="btn btn-outline-success"
                                invisible="not invoice_id or invoice_state != 'posted' or invoice_payment_state == 'paid'"/>
		   </group>

		   <notebook>
    		  	<page string="Students">
        			<field name="student_ids">
            				<list>
                				<field name="student_id"/>
                				<field name="name"/>
                				<field name="email"/>
                				<field name="phone"/>
            				</list>
        			</field>
    			</page>
		   </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Open Courses Action -->
    <record id="academy_course_action" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">academy.course</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first course!
            </p>
        </field>
    </record>

    <!-- Courses Menu -->
    <menuitem
        id="academy_course_menu"
        name="Courses"
        parent="academy_management_menu_root"
        action="academy_course_action"
        sequence="20"
    />

</odoo>
