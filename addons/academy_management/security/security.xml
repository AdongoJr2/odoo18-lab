<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_academy_teacher" model="res.groups">
        <field name="name">Academy Teacher</field>
        <field name="category_id" ref="base.module_category_education"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_academy_manager" model="res.groups">
        <field name="name">Academy Manager</field>
        <field name="category_id" ref="base.module_category_education"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_academy_teacher'))]"/>
    </record>

    <record id="group_academy_student" model="res.groups">
        <field name="name">Academy Student</field>
        <field name="category_id" ref="base.module_category_education"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_academy_student_manager" model="ir.rule">
        <field name="name">Academy managers: all students</field>
        <field name="model_id" ref="model_academy_student"/>
        <field name="groups" eval="[(4, ref('group_academy_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_academy_student_teacher" model="ir.rule">
        <field name="name">Academy teachers: all students</field>
        <field name="model_id" ref="model_academy_student"/>
        <field name="groups" eval="[(4, ref('group_academy_teacher'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_academy_student_owner" model="ir.rule">
        <field name="name">Academy students: own profile</field>
        <field name="model_id" ref="model_academy_student"/>
        <field name="groups" eval="[(4, ref('group_academy_student'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_academy_attendance_manager" model="ir.rule">
        <field name="name">Academy managers: all attendance</field>
        <field name="model_id" ref="model_academy_attendance"/>
        <field name="groups" eval="[(4, ref('group_academy_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_academy_attendance_teacher" model="ir.rule">
        <field name="name">Academy teachers: all attendance</field>
        <field name="model_id" ref="model_academy_attendance"/>
        <field name="groups" eval="[(4, ref('group_academy_teacher'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_academy_attendance_owner" model="ir.rule">
        <field name="name">Academy students: own attendance</field>
        <field name="model_id" ref="model_academy_attendance"/>
        <field name="groups" eval="[(4, ref('group_academy_student'))]"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
    </record>
</odoo>
