<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="model_x_academy_catalog_course" model="ir.model">
        <field name="name">Academy Catalog Course</field>
        <field name="model">x_academy.catalog.course</field>
    </record>

    <record id="field_x_academy_catalog_course_name" model="ir.model.fields">
        <field name="model_id" ref="model_x_academy_catalog_course" />
        <field name="name">x_name</field>
        <field name="field_description">Course Name</field>
        <field name="ttype">char</field>
        <field name="required">True</field>
        <field name="index">True</field>
    </record>

    <record id="field_x_academy_catalog_course_code" model="ir.model.fields">
        <field name="model_id" ref="model_x_academy_catalog_course" />
        <field name="name">x_code</field>
        <field name="field_description">Course Code</field>
        <field name="ttype">char</field>
        <field name="required">True</field>
        <field name="index">True</field>
    </record>

    <record id="field_x_academy_catalog_course_description" model="ir.model.fields">
        <field name="model_id" ref="model_x_academy_catalog_course" />
        <field name="name">x_description</field>
        <field name="field_description">Description</field>
        <field name="ttype">html</field>
    </record>

    <record id="field_x_academy_catalog_course_capacity" model="ir.model.fields">
        <field name="model_id" ref="model_x_academy_catalog_course" />
        <field name="name">x_capacity</field>
        <field name="field_description">Capacity</field>
        <field name="ttype">integer</field>
        <field name="required">True</field>
    </record>

    <record id="field_x_academy_catalog_course_active" model="ir.model.fields">
        <field name="model_id" ref="model_x_academy_catalog_course" />
        <field name="name">x_active</field>
        <field name="field_description">Active</field>
        <field name="ttype">boolean</field>
    </record>

    <record id="default_x_academy_catalog_course_capacity" model="ir.default">
        <field name="field_id" ref="field_x_academy_catalog_course_capacity" />
        <field name="json_value">0</field>
    </record>

    <record id="default_x_academy_catalog_course_active" model="ir.default">
        <field name="field_id" ref="field_x_academy_catalog_course_active" />
        <field name="json_value">true</field>
    </record>
</odoo>
