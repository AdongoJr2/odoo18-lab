<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_x_academy_catalog_course_list" model="ir.ui.view">
        <field name="name">x.academy.catalog.course.list</field>
        <field name="model">x_academy.catalog.course</field>
        <field name="arch" type="xml">
            <list string="Catalog Courses">
                <field name="x_code" />
                <field name="x_name" />
                <field name="x_capacity" />
                <field name="x_active" />
            </list>
        </field>
    </record>

    <record id="view_x_academy_catalog_course_form" model="ir.ui.view">
        <field name="name">x.academy.catalog.course.form</field>
        <field name="model">x_academy.catalog.course</field>
        <field name="arch" type="xml">
            <form string="Catalog Course">
                <sheet>
                    <group>
                        <field name="x_code" />
                        <field name="x_name" />
                        <field name="x_capacity" />
                        <field name="x_active" />
                    </group>
                    <field name="x_description" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_x_academy_catalog_course" model="ir.actions.act_window">
        <field name="name">Catalog Courses</field>
        <field name="res_model">x_academy.catalog.course</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_academy_catalog_root" name="Academy Catalog" sequence="30" />
    <menuitem
        id="menu_x_academy_catalog_course"
        name="Courses"
        parent="menu_academy_catalog_root"
        action="action_x_academy_catalog_course"
        sequence="10"
    />
</odoo>
